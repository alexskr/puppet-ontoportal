 <%- |
  String $admin_user,
  Stdlib::Absolutepath $app_root_dir,
  Stdlib::Absolutepath $log_dir,
| -%>
#
# Aliases for OntoPortal Operations
#
export PATH=/usr/local/ontoportal/bin:$PATH
alias suop="sudo su - <%= $admin_user %>"

# Navigation
alias gocron="pushd <%= $app_root_dir %>/ncbo_cron"
alias goapi="pushd <%= $app_root_dir %>/ontologies_api/current"
alias goui="pushd <%= $app_root_dir %>/bioportal_web_ui/current"
alias gova="pushd <%= $app_root_dir %>/virtual_appliance"
alias gopuppet="pushd /etc/puppetlabs/code/environments/production"

# Logs
alias logapi="tail -fn 100 <%= $log_dir %>/ontologies_api/appliance.log"
alias logui="tail -fn 100 <%= $log_dir %>/puma-ui/appliance.log"
alias logcron="tail -fn 100 <%= $log_dir %>/ncbo_cron/scheduler.log"

# service control aliases
alias oprestart="sudo /usr/local/bin/opctl restart"
alias opstart="sudo /usr/local/bin/opctl start"
alias opstop="sudo /usr/local/bin/opctl stop"
alias opstatus="sudo /usr/local/bin/opctl status"

# Puppet
alias runpuppet="<%= $app_root_dir %>/virtual_appliance/infra/run_masterless_puppet.sh r10k"
alias runpuppetnoop="<%= $app_root_dir %>/virtual_appliance/infra/run_masterless_puppet.sh noop"
